# Optional preparation only. The demo does not require these variables.
# Copy to .env.local and use the project's public URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Python auth service URL (Next.js server to Python server).
AUTH_SERVICE_URL=http://127.0.0.1:8000
# Use the same long random secret for both processes; never expose it in browser code.
AUTH_INTERNAL_TOKEN=
